{
  "name": "blackfawn-workspace",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "storefront",
    "admin",
    "server",
    "shared"
  ],
  "scripts": {
    "build": "npm --prefix storefront run build && npm --prefix admin run build && npm --prefix server run build",
    "dev:storefront": "npm --prefix storefront run dev",
